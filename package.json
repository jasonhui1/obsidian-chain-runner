{
  "name": "obsidian-chain-runner",
  "version": "0.1.0",
  "description": "Run maestro-playground insight chains against vault material, on an Excalidraw drawing.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests scripts",
    "smoke": "tsx scripts/smoke.ts",
    "install:vault": "node scripts/install.mjs",
    "deploy": "npm run build && npm run install:vault",
    "use:before": "node scripts/use.mjs before",
    "use:after": "node scripts/use.mjs after"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@lezer/highlight": "^1.2.3",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "jsdom": "^30.0.1",
    "obsidian": "^1.7.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6"
  }
}
